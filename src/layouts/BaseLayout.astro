---
import UnifiedNav from "../components/UnifiedNav.astro";
import { isCurrentItem, isCurrentLink, siteChrome, withBasePath, type ChromeNavItem } from "../lib/siteChrome";
import { getActiveLessons } from "../lib/lessons";
import { TOPIC_TERMS } from "../data/topics";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Open source learning pathways and curated lessons from the UC OSPO Network.",
} = Astro.props as Props;

const basePath = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");

// Category sub-nav under "Lessons" (#199): top 6 Topics by live lesson count,
// computed here rather than hand-curated so it tracks tagging changes.
// Not a second browsing mechanism — same data the Topic facet on /lessons
// itself uses, just surfaced as preset deep-links in the persistent sidebar.
const activeLessons = await getActiveLessons();
const topicCounts: Record<string, number> = {};
for (const lesson of activeLessons) {
  for (const topic of lesson.topics) topicCounts[topic] = (topicCounts[topic] ?? 0) + 1;
}
const topTopics = [...TOPIC_TERMS]
  .sort((a, b) => (topicCounts[b.name] ?? 0) - (topicCounts[a.name] ?? 0) || a.name.localeCompare(b.name))
  .slice(0, 6);
const lessonsTopicChildren: ChromeNavItem[] = [
  ...topTopics.map((term) => ({
    label: term.name,
    href: `/lessons?topic=${encodeURIComponent(term.name)}`,
    count: topicCounts[term.name] ?? 0,
  })),
  { label: "View all topics", href: "/lessons/topic" },
];

const sidebarItems = siteChrome.nav.map((item) => ({
  ...item,
  current: isCurrentItem(basePath, Astro.url.pathname, item),
  hrefResolved: item.external ? item.href : withBasePath(import.meta.env.BASE_URL, item.href),
  childrenResolved: (item.children ?? []).map((child) => {
    const grandchildren = child.href === "/lessons" ? lessonsTopicChildren : (child.children ?? []);
    return {
      ...child,
      current: isCurrentLink(basePath, Astro.url.pathname, child.href),
      hrefResolved: child.external ? child.href : withBasePath(import.meta.env.BASE_URL, child.href),
      childrenResolved: grandchildren.map((grandchild) => ({
        ...grandchild,
        hrefResolved: grandchild.external
          ? grandchild.href
          : withBasePath(import.meta.env.BASE_URL, grandchild.href),
      })),
    };
  }),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={`${title} | UC OSPO Education`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="UC OSPO Education" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | UC OSPO Education`} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}pagefind/pagefind-component-ui.css`} />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}styles.css`} />
    <title>{title} | UC OSPO Education</title>
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <UnifiedNav />

      <main id="main-content" class="site-main">
        <div class="site-layout">
          <aside class="site-sidebar" aria-label="Section navigation" data-pagefind-ignore>
            <div class="site-sidebar__inner">
              <p class="site-sidebar__eyebrow">UC OSPO Network</p>
              <nav class="site-sidebar__nav" aria-label="Site sections">
                <ul class="site-sidebar__list">
                  {sidebarItems.map((item, index) => {
                    const hasChildren = item.childrenResolved.length > 0;
                    const isExpanded = item.current || (hasChildren && item.childrenResolved.some((c) => c.current));
                    const checkboxId = `sidebar-toggle-${index}`;
                    return (
                      <li class={`site-sidebar__item${item.current ? " is-current" : ""}${hasChildren ? " has-children" : ""}`}>
                        {hasChildren && (
                          <input 
                            type="checkbox" 
                            id={checkboxId} 
                            class="site-sidebar__toggle-checkbox sr-only" 
                            checked={isExpanded ? true : undefined} 
                          />
                        )}
                        <div class="site-sidebar__item-header">
                          <a
                            class="site-sidebar__link"
                            href={item.hrefResolved}
                            target={item.external ? "_blank" : undefined}
                            rel={item.external ? "noopener noreferrer" : undefined}
                          >
                            {item.label}
                          </a>
                          {hasChildren && (
                            <label for={checkboxId} class="site-sidebar__toggle-label">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="site-sidebar__caret">
                                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                              </svg>
                              <span class="sr-only">Toggle {item.label}</span>
                            </label>
                          )}
                        </div>

                        {hasChildren ? (
                          <ul class="site-sidebar__sublist">
                            {item.childrenResolved.map((child) => (
                              <li class={`site-sidebar__subitem${child.current ? " is-current" : ""}`}>
                                <a
                                  class="site-sidebar__sublink"
                                  href={child.hrefResolved}
                                  target={child.external ? "_blank" : undefined}
                                  rel={child.external ? "noopener noreferrer" : undefined}
                                >
                                  {child.label}
                                </a>
                                {child.childrenResolved.length > 0 && (
                                  <ul class="site-sidebar__subsublist">
                                    {child.childrenResolved.map((grandchild) => (
                                      <li class="site-sidebar__subsubitem">
                                        <a
                                          class="site-sidebar__subsublink"
                                          href={grandchild.hrefResolved}
                                          target={grandchild.external ? "_blank" : undefined}
                                          rel={grandchild.external ? "noopener noreferrer" : undefined}
                                        >
                                          <span>{grandchild.label}</span>
                                          {grandchild.count !== undefined && (
                                            <span class="site-sidebar__subsublink-count">{grandchild.count}</span>
                                          )}
                                        </a>
                                      </li>
                                    ))}
                                  </ul>
                                )}
                              </li>
                            ))}
                          </ul>
                        ) : null}
                      </li>
                    );
                  })}
                </ul>
              </nav>
            </div>
          </aside>

          <div class="site-content" data-pagefind-body>
            <slot />
          </div>
        </div>
      </main>

      <footer class="site-footer">
        <div class="site-footer__inner">
          <a class="site-footer__brand" href={siteChrome.brand.homeHref} aria-label="UC OSPO Network">
            <img
              src={`${import.meta.env.BASE_URL}uc-ospo-network-logo.svg`}
              alt="UC OSPO Network"
              class="logo-dark"
            />
            <img
              src={`${import.meta.env.BASE_URL}uc-ospo-network-logo-light.svg`}
              alt="UC OSPO Network"
              class="logo-light"
            />
          </a>

          <nav class="site-footer__social" aria-label="UC OSPO social links">
            {siteChrome.footer.social.map((item) => (
              <a
                class="site-footer__social-link"
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                aria-label={item.label}
              >
                <img src={`${import.meta.env.BASE_URL}${item.icon.replace(/^\//, "")}`} alt="" aria-hidden="true" />
              </a>
            ))}
          </nav>

          <div class="site-footer__legal">
            <a href={`${import.meta.env.BASE_URL}accessibility`} class="site-footer__legal-link">
              Accessibility
            </a>
            {/* TEMP: points at jt14den fork for committee review — suggest-lesson.yml
                isn't merged to org main yet. Repoint to UC-OSPO-Network/education once it is. */}
            <a
              href="https://github.com/jt14den/education/issues/new?template=suggest-lesson.yml"
              target="_blank"
              rel="noopener noreferrer"
              class="site-footer__legal-link"
            >
              Suggest a Lesson
            </a>
            <a
              href="https://github.com/UC-OSPO-Network/education/issues/new?template=lesson-feedback.yml"
              target="_blank"
              rel="noopener noreferrer"
              class="site-footer__legal-link"
            >
              Give Feedback
            </a>
            <a
              href="https://www.w3.org/WAI/WCAG2AA-Conformance"
              title="Explanation of WCAG 2.1 Level AA Conformance"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src="https://www.w3.org/WAI/wcag21/wcag2.1AA-blue-v.svg"
                alt="Level AA conformance, W3C WAI Web Content Accessibility Guidelines 2.1"
                width="88"
                height="31"
                class="site-footer__wcag-badge"
              />
            </a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
