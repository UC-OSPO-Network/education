---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../components/home/home.css';
import { getActiveLessons } from '../lib/lessons';
import { TOPIC_TERMS } from '../data/topics';

const base = import.meta.env.BASE_URL;
const activeLessons = await getActiveLessons();
const lessonCount = activeLessons.length;
const topicCount = TOPIC_TERMS.length;
const gettingStartedCount = activeLessons.filter((l) => l.pathways.includes('getting-started')).length;
---

<BaseLayout title="UC OSPO Education">
  <div class="home-page">
    <section class="home-hero">
      <div class="content-container">
        <h1 class="home-hero__title">Open source learning for research and teaching</h1>
        <p class="home-hero__lede">
          Explore {lessonCount} free lessons curated by the UC OSPO Network for researchers,
          developers, maintainers, project leads, librarians, and instructors.
        </p>
        <p class="home-hero__proof">
          {lessonCount} curated resources &middot; {topicCount} standards-informed topics &middot;
          Six UC campuses &middot; Workshops, courses, and practical guides
        </p>
        <p class="home-hero__transparency">
          We curate and describe these resources — the original organizations host and maintain
          the lessons themselves.
        </p>
      </div>
    </section>

    <section class="home-routes" aria-label="Get started">
      <div class="content-container home-routes__grid">
        <a class="home-route-card" href={`${base}lessons`}>
          <h2 class="home-route-card__title">Browse all lessons</h2>
          <p class="home-route-card__body">
            Search and filter the complete catalog by topic, role, or skill level.
          </p>
        </a>

        <a class="home-route-card" href={`${base}lessons#getting-started-heading`}>
          <h2 class="home-route-card__title">New to open source?</h2>
          <p class="home-route-card__body">
            Start with {gettingStartedCount} introductory lessons on what open source is and how
            to make your first contribution.
          </p>
        </a>

        <a class="home-route-card" href={`${base}lessons`}>
          <h2 class="home-route-card__title">Planning instruction?</h2>
          <p class="home-route-card__body">
            Select lessons on the catalog page and build a teaching plan with the Workshop
            Planning Worksheet.
          </p>
        </a>
      </div>
    </section>

    <section class="home-topics">
      <div class="content-container">
        <p class="home-topics__summary">
          Find material on version control, licensing and reuse, testing and automation, security
          and supply chains, governance, sustainability, research software, and more.
          <a href={`${base}lessons/topic`}>Explore all {topicCount} topics</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
